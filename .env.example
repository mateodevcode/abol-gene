# Copia a .env.local y completa valores reales. Nunca commitees .env.local
# .env.example solo lleva PLACEHOLDERS, jamás credenciales reales.
DATABASE_URL=postgresql://usuario:password@host:5432/family_tree
STORAGE_DRIVER=local
MAIL_DRIVER=console # smtp para enviar correo real (Brevo), ses en Fase 9
NEXT_PUBLIC_STORAGE_DRIVER=local # s3 en producción (debe coincidir con STORAGE_DRIVER)
# Auth.js (NextAuth v4). Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000
